# Daily-calls pipeline secrets.
# On the VPS this file lives at /etc/daily-calls/.env (chmod 600, owner root).
# In dev (Mac), keep a copy at the repo root for local testing.

# --- HubSpot ---
HUBSPOT_TOKEN=

# --- OpenAI Whisper ---
OPENAI_API_KEY=

# --- DeepSeek (analysis model) ---
DEEPSEEK_API_KEY=

# --- Gmail SMTP (outbound reports) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Google Cloud Storage ---
# Bucket: ai-call-reports (EU multi-region)
GCS_BUCKET=ai-call-reports
# On VPS: /etc/daily-calls/gcs-sa.json — on Mac dev: repo-relative credentials/gcs-sa.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/daily-calls/gcs-sa.json

# --- Pipeline failure alerts (comma-separated) ---
PIPELINE_FAILURE_EMAILS=analytics.karma@gmail.com,andre.nascimento@karma-network.com,luis.correia@karma-network.com

# --- Healthchecks.io (optional — leave blank to disable) ---
# Create a check at https://healthchecks.io with schedule "0 4 * * *" Europe/Lisbon
# Pipeline pings <URL>/start at boot, <URL> on success, <URL>/fail on global crash.
HEALTHCHECK_URL=
